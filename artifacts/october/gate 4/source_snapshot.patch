+"""Guard the new reproduction entry point without training a real model."""
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from scripts import reproduce_october_gate4 as g
+from scripts.evaluation import EvaluationError
+
+
+class Gate4Tests(unittest.TestCase):
+    def setUp(self):
+        self.expected = {'python': '3.13.5', **{p: '1.0' for p in g.x.PACKAGES}}
+        self.actual = {'python': '3.13.5', 'packages': {p: '1.0' for p in g.x.PACKAGES}}
+
+    def test_exact_environment(self):
+        self.assertTrue(g.environment_check(self.expected, self.actual))
+
+    def test_python_difference_fails_by_default(self):
+        self.actual['python'] = '3.13.2'
+        with self.assertRaises(EvaluationError):
+            g.environment_check(self.expected, self.actual)
+        self.assertFalse(g.environment_check(self.expected, self.actual, True))
+
+    def test_opt_in_cannot_allow_package_or_python_minor_changes(self):
+        self.actual['packages']['xgboost'] = '9.0'
+        with self.assertRaises(EvaluationError):
+            g.environment_check(self.expected, self.actual, True)
+        self.actual['packages']['xgboost'] = '1.0'
+        self.actual['python'] = '3.14.0'
+        with self.assertRaises(EvaluationError):
+            g.environment_check(self.expected, self.actual, True)
+
+    def test_dirty_checkout_stops_before_output_or_training(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.object(g.x, 'git', return_value='?? draft.md'), \
+                patch.object(g.x, 'real_inputs') as inputs:
+            output = Path(tmp) / 'evidence'
+            with self.assertRaises(EvaluationError):
+                g.run(output)
+            self.assertFalse(output.exists())
+            inputs.assert_not_called()
+
+    def test_output_inside_checkout_is_rejected(self):
+        with self.assertRaises(EvaluationError):
+            g.run(g.x.ROOT / 'artifacts' / 'not-created')
+
+    def test_retained_followup_cannot_replace_depth_seven(self):
+        import json
+        retained = {'retained_candidate': 'A2-C06', 'followup_retained': True}
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            path = root / g.RETAINED
+            path.parent.mkdir(parents=True)
+            path.write_text(json.dumps(retained))
+            with self.assertRaises(EvaluationError):
+                g.retained_inputs(root, {}, {'final_candidate': 'A2-C06'})
+
+
+if __name__ == '__main__':
+    unittest.main()
